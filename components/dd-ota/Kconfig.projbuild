menu "DogDog OTA"
    config DOGDOG_OTA_ENABLED
        bool "Enable DogDog OTA boot probe"
        default y
        help
            On boot, scan for the dedicated DogDog OTA Wi-Fi. If it is found
            and the device can connect, download a firmware image from the
            configured short OTA relay URL.

    config DOGDOG_OTA_WIFI_SSID
        string "DogDog OTA Wi-Fi SSID"
        depends on DOGDOG_OTA_ENABLED
        default "dogdog-ota"

    config DOGDOG_OTA_WIFI_PASSWORD
        string "DogDog OTA Wi-Fi password"
        depends on DOGDOG_OTA_ENABLED
        default "dogdog-ota"

    config DOGDOG_OTA_BASE_URL
        string "DogDog OTA base URL"
        depends on DOGDOG_OTA_ENABLED
        default "https://ota.dogdog-zeitmessung.de"
        help
            Firmware URLs are built as <base>/firmware/<device>.bin.

    config DOGDOG_OTA_FALLBACK_DEVICE_NAME
        string "Fallback OTA device name"
        depends on DOGDOG_OTA_ENABLED
        default "measure-stations-lora"
        help
            Used only by legacy code paths that still call ota_task without
            passing an explicit device name.

    config DOGDOG_OTA_CONNECT_RETRIES
        int "DogDog OTA Wi-Fi connect retries"
        depends on DOGDOG_OTA_ENABLED
        range 1 20
        default 8

    config DOGDOG_OTA_CONNECT_TIMEOUT_MS
        int "DogDog OTA Wi-Fi connect timeout"
        depends on DOGDOG_OTA_ENABLED
        range 1000 60000
        default 12000

    config DOGDOG_OTA_RECV_TIMEOUT_MS
        int "DogDog OTA receive timeout"
        depends on DOGDOG_OTA_ENABLED
        range 1000 60000
        default 10000

    config DOGDOG_OTA_ENABLE_PARTIAL_HTTP_DOWNLOAD
        bool "Enable partial HTTP download"
        depends on DOGDOG_OTA_ENABLED
        default n
        help
            Disable this by default for OTA images on noisy or weak Wi-Fi links:
            the partial-download path can be much slower because it issues many
            small incremental reads. Enable only when the device has a very
            constrained memory budget and the network is known to be reliable.

    config DOGDOG_OTA_HTTP_REQUEST_SIZE
        int "Partial HTTP request size"
        depends on DOGDOG_OTA_ENABLE_PARTIAL_HTTP_DOWNLOAD
        range 8192 131072
        default 65536
        help
            When partial HTTP downloads are enabled, use a much larger chunk to
            avoid the tiny read loop that causes very low throughput.

    config DOGDOG_OTA_TASK_STACK_SIZE
        int "DogDog OTA worker task stack size"
        depends on DOGDOG_OTA_ENABLED
        range 8192 32768
        default 24576
        help
            HTTPS OTA uses significantly more stack than ESP-IDF's main task.
            The boot probe runs in this temporary task and app_main waits for
            it to finish or reboot.
endmenu
