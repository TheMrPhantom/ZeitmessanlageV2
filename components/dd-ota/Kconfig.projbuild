menu "OTA Settings"
    config DD_OTA_USE_CERTIFICATE_BUNDLE
        bool
        default y
        select MBEDTLS_CERTIFICATE_BUNDLE

    config DD_OTA_ENABLE_ROLLBACK
        bool "Enable application rollback"
        default y
        select BOOTLOADER_APP_ROLLBACK_ENABLE
        help
            Keep newly installed images in pending-verification state until the
            application calls dd_ota_mark_app_valid().

    menu "Download Settings"
        config DD_OTA_BASE_URL
            string "Firmware server base URL"
            default "https://ota.dogdog-zeitmessung.de"
            help
                HTTPS origin hosting firmware without redirects. The component
                appends /<project-name>.bin to this value.

        config DD_OTA_RECV_TIMEOUT_MS
            int "OTA receive timeout (ms)"
            default 5000
            range 1000 120000
            help
                Maximum time in milliseconds for an OTA HTTP receive operation.

        config DD_OTA_NO_PROGRESS_TIMEOUT_MS
            int "OTA no-progress timeout (ms)"
            default 60000
            range 5000 600000
            help
                Abort and reboot if no additional firmware bytes are received
                for this long. The timer is reset whenever download progress is
                made, so it does not limit the total update duration.

        config DD_OTA_ENABLE_PARTIAL_HTTP_DOWNLOAD
            bool "Enable partial HTTP download"
            default y
            help
                This enables use of Range header in esp_https_ota component.
                Firmware image will be downloaded over multiple HTTP requests.

        config DD_OTA_HTTP_REQUEST_SIZE
            int "HTTP request size"
            default 16384
            range 4096 65536
            depends on DD_OTA_ENABLE_PARTIAL_HTTP_DOWNLOAD
            help
                Number of bytes requested in each partial HTTP download request.
    endmenu

    menu "Worker Settings"
        config DD_OTA_TASK_STACK_SIZE
            int "OTA worker stack size"
            default 16384
            range 8192 32768
            help
                Stack allocated to the HTTPS OTA worker task, in bytes.

        config DD_OTA_TASK_PRIORITY
            int "OTA worker priority"
            default 5
            range 1 24
            help
                FreeRTOS priority used by the shared OTA worker task.

        config DD_OTA_FAILURE_REBOOT_DELAY_MS
            int "Failure reboot delay (ms)"
            default 5000
            range 0 60000
            help
                Time provided to the application to display a failure status
                before rebooting into the unchanged firmware.

        config DD_OTA_SUCCESS_REBOOT_DELAY_MS
            int "Success reboot delay (ms)"
            default 1000
            range 0 10000
            help
                Time provided to the application to display success before
                rebooting into the newly installed firmware.
    endmenu

    # WiFi Settings Submenu
    menu "WiFi Settings"
        config ESP_WIFI_SSID
            string "WiFi SSID"
            default "zeitmessanlage"
            help
                SSID (network name) for the device to connect to.

        config ESP_WIFI_PASSWORD
            string "WiFi Password"
            default "zeitmessanlage"
            help
                WiFi password (WPA or WPA2) for the device to use.

        choice ESP_WIFI_SAE_MODE
            prompt "WPA3 SAE mode selection"
            default ESP_WPA3_SAE_PWE_BOTH
            help
                Select mode for SAE as Hunt and Peck, H2E or both.
            config ESP_WPA3_SAE_PWE_HUNT_AND_PECK
                bool "HUNT AND PECK"
            config ESP_WPA3_SAE_PWE_HASH_TO_ELEMENT
                bool "H2E"
            config ESP_WPA3_SAE_PWE_BOTH
                bool "BOTH"
        endchoice

        config ESP_WIFI_PW_ID
            string "Password Identifier"
            depends on ESP_WPA3_SAE_PWE_HASH_TO_ELEMENT || ESP_WPA3_SAE_PWE_BOTH
            default ""
            help
                Password identifier for SAE H2E mode.

        config OTA_WIFI_MAXIMUM_RETRY
            int "Maximum WiFi connection retries"
            default 5
            range 0 100
            help
                Number of reconnection attempts before the OTA request is abandoned.

        config OTA_WIFI_CONNECT_TIMEOUT_MS
            int "WiFi connection timeout (ms)"
            default 30000
            range 1000 300000
            help
                Maximum total time to wait for an IP address before abandoning the
                OTA request.

    endmenu
endmenu
