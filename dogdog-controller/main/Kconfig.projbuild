menu "EDIT HERE: Zeitmessanlage configuration"
    config IS_LORA_CONTROLLER
        bool "is_lora_controller"
        default y
        help
            Set to true if this device is a LoRa controller. This value will be
            available in code as CONFIG_IS_LORA_CONTROLLER.
    config SENSOR_AMOUNT
        int "sensor_amount"
        range 0 255
        default 4
        depends on !IS_LORA_CONTROLLER
        help
            Number of sensors connected to the controller. Must be an integer
            between 0 and 255. This value will be available in code as
            CONFIG_SENSOR_AMOUNT.
    config HORN_TIMER_WIFI_CHANNEL
        int "horn_timer_wifi_channel"
        range 1 13
        default 1
        help
            Wi-Fi channel used to broadcast timer elapsed time for the horn.
            This must match CONFIG_BUZZER_SOFTAP_CHANNEL in the horn project.
    config TIMEPANEL_ENABLED
        bool "timepanel_enabled"
        default y
        help
            Send timer, result and parcours commands to the HUB75 timepanel.
    config TIMEPANEL_MAC_ID
        hex "timepanel_mac_id"
        range 0x0000 0xFFFF
        default 0x0002
        help
            Configurable last two bytes of the timepanel MAC. The fixed DogDog
            prefix is de:09:dd:09, so 0x0002 becomes de:09:dd:09:00:02.
    config TIMEPANEL_TEST_TIMER_SEQUENCE
        bool "temporary_timepanel_timer_test_sequence"
        depends on TIMEPANEL_ENABLED
        default n
        help
            Temporary test mode: after boot, send a start trigger into the
            controller timer and then send stop triggers after randomized
            durations. Disable this before real event operation.
    config TIMEPANEL_TEST_TIMER_START_DELAY_MS
        int "temporary_timepanel_timer_test_start_delay_ms"
        depends on TIMEPANEL_TEST_TIMER_SEQUENCE
        range 0 600000
        default 15000
    config TIMEPANEL_TEST_TIMER_REPETITIONS
        int "temporary_timepanel_timer_test_repetitions"
        depends on TIMEPANEL_TEST_TIMER_SEQUENCE
        range 1 100
        default 5
    config TIMEPANEL_TEST_TIMER_GAP_MS
        int "temporary_timepanel_timer_test_gap_ms"
        depends on TIMEPANEL_TEST_TIMER_SEQUENCE
        range 0 600000
        default 7000
    config TIMEPANEL_TEST_TIMER_RUN_MS
        int "temporary_timepanel_timer_test_run_min_ms"
        depends on TIMEPANEL_TEST_TIMER_SEQUENCE
        range 1 600000
        default 20000
    config TIMEPANEL_TEST_TIMER_RUN_MAX_MS
        int "temporary_timepanel_timer_test_run_max_ms"
        depends on TIMEPANEL_TEST_TIMER_SEQUENCE
        range 1 600000
        default 23000
endmenu
